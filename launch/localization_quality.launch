<launch>

    <arg name="tall" default="false"/>

    <group if="$(arg tall)">
        <param name="mean_weight_limit" value="2.0"/>
        <param name="weight_drop_factor" value="0.6"/>
    </group>
    <group unless="$(arg tall)">
        <param name="mean_weight_limit" value="2.0"/>
        <param name="weight_drop_factor" value="0.6"/>
    </group>

    <node pkg="mattbot_mcl" type="localization_quality.py" name="localization_quality_node" output="screen">
        <!-- Periodic TRACK-mode scan score lines on screen; scores still publish on ~scan_match_* topics -->
        <param name="log_scan_match_diagnostics" value="false"/>
        <param name="diagnostics_log_interval" value="2.0"/>
        <!-- Relative drop is primary; set use_absolute_score_floor true to also use mean_weight_limit -->
        <param name="use_absolute_score_floor" value="false"/>
        <param name="min_improvement_ratio" value="1.15"/>
        <param name="max_recovery_pose_distance" value="3.0"/>
        <param name="recovery_history_length" value="20"/>
        <param name="local_search_radius" value="0.2"/>
        <param name="local_search_step" value="0.2"/>
        <param name="recovery_cooldown_sec" value="7.5"/>
        <param name="localized_laser_range_max" value="3.0"/>
        <!-- Skip loss detection briefly after ALIGN->TRACK (avoids false recovery) -->
        <param name="track_monitor_grace_sec" value="1.0"/>
        <!-- Reject implausible AMCL jumps during TRACK; inject last good history pose -->
        <param name="pose_jump_detection_enabled" value="true"/>
        <param name="max_pose_jump_m" value="0.5"/>
        <param name="max_pose_jump_theta" value="0.5"/>
        <param name="post_recovery_jump_grace_sec" value="2.0"/>
    </node>

</launch>
